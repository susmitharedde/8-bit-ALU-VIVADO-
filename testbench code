`timescale 1ns / 1ps

module bit_alu_tb;

reg [7:0] A, B;
reg [2:0] opcode;

wire [7:0] result;
wire carry;

bit_alu uut (
    .A(A),
    .B(B),
    .opcode(opcode),
    .result(result),
    .carry(carry)
);

initial begin

    A = 8'b00001111;
    B = 8'b00000011;

    opcode = 3'b000; #10;
    opcode = 3'b001; #10;
    opcode = 3'b010; #10;
    opcode = 3'b011; #10;
    opcode = 3'b100; #10;
    opcode = 3'b101; #10;
    opcode = 3'b110; #10;
    opcode = 3'b111; #10;

    $finish;

end

endmodule